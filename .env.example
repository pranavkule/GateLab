# Copy to .env (a dev .env is already committed for convenience)

# Ports
ENTRY_LB_PORT=3000
GATEWAY_PORTS=3001,3002,3003
CONTROL_PLANE_PORT=5000
AUTH_PORT=5001
# Backend service instances: port=serviceKey (users/products/orders)
BACKEND_INSTANCES=4001:users,4004:users,4002:products,4005:products,4003:orders,4006:orders

# Databases
MONGO_URI=mongodb://localhost:27017/edgegate
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=edgegate-dev-secret-change-in-production
JWT_EXPIRES_IN=1h
DEMO_USER=admin
DEMO_PASSWORD=admin123

# Health checks (ms)
HEALTH_CHECK_INTERVAL=3000
PROXY_TIMEOUT=8000
