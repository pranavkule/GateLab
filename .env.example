# Copy to .env for local development. For Docker production, create a separate
# .env.production file (ignored by Git) and set the variables shown below.
# Never commit real secrets or put them in this example.

# -------------------------------
# Local development defaults
# -------------------------------
NODE_ENV=development
ENTRY_LB_PORT=3010
GATEWAY_PORTS=3011,3012,3013
CONTROL_PLANE_PORT=5010
AUTH_PORT=5011
BACKEND_INSTANCES=4011:users,4014:users,4012:products,4015:products,4013:orders,4016:orders

MONGO_URI=mongodb://127.0.0.1:27018/edgegate
REDIS_URL=redis://localhost:6380
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=

# Frontend development server
VITE_PORT=5174
VITE_CONTROL_PLANE_PORT=5010
VITE_AUTH_PORT=5011
VITE_ENTRY_LB_PORT=3010
VITE_CONTROL_PLANE_URL=
VITE_AUTH_URL=
VITE_ENTRY_LB_URL=

# Browser origins allowed to call backend services.
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Auth (replace locally; this deliberately short placeholder fails production validation)
JWT_SECRET=replace-me-before-production
JWT_EXPIRES_IN=1h
DEMO_USER=admin
DEMO_PASSWORD=replace-with-a-local-only-demo-password

# Health checks (ms)
HEALTH_CHECK_INTERVAL=3000
PROXY_TIMEOUT=8000

# Circuit breaker (P2.5.1) - shared Redis state across gateways
# CB_FAILURE_THRESHOLD: consecutive backend failures (5xx / unreachable /
# timeout) that open a circuit. CB_COOLDOWN_MS: how long an OPEN circuit
# blocks an instance before HALF-OPEN probes are admitted.
# CB_HALF_OPEN_PROBES: test requests admitted while HALF-OPEN (shared).
CB_FAILURE_THRESHOLD=5
CB_COOLDOWN_MS=10000
CB_HALF_OPEN_PROBES=1

# Worker respawn supervision (P2.6.1)
# WORKER_RESPAWN=false disables auto-respawn (default: enabled).
# WORKER_MAX_RESTARTS: refork attempts per worker within WORKER_RESTART_WINDOW_MS
# before the supervisor stops respawning that worker (restart-loop guard).
# WORKER_RESTART_BACKOFF_MS: initial backoff, doubled per restart (capped).
# WORKER_MAX_RESTARTS=5
# WORKER_RESTART_WINDOW_MS=60000
# WORKER_RESTART_BACKOFF_MS=1000

# Authentication throttling (P2.6.1) - Redis-backed fixed window per client IP
# AUTH_LOGIN_RATE_LIMIT: max login attempts per window (default 10).
# AUTH_REGISTER_RATE_LIMIT: max registrations per window (default 10).
# AUTH_RATE_WINDOW_MS: window duration in ms (default 300000 = 5 minutes).
# Lab Reset (/api/reset) clears these windows. Unset in local dev = defaults.
# AUTH_LOGIN_RATE_LIMIT=10
# AUTH_REGISTER_RATE_LIMIT=10
# AUTH_RATE_WINDOW_MS=300000

# Trusted proxies (P2.6.1) - comma-separated IPs / IPv4 CIDR ranges whose
# forwarded headers (X-Real-IP, X-Forwarded-For) are honoured for client-IP
# resolution. Unset: only loopback peers are trusted (direct development).
# Docker Compose trusts only the frontend at 172.30.250.2.
# TRUSTED_PROXIES=172.30.250.2

# -------------------------------
# Docker production variables (Compose reads these from .env.production)
# -------------------------------
# Do not uncomment these examples verbatim or reuse local-development URLs.
# Create authenticated connection URLs with URL-encoded credentials as needed.
# Docker URLs must use service names, not localhost/127.0.0.1.
# Compose requires all of the variables below and has no insecure secret defaults.
#
# REDIS_PASSWORD=<fresh strong Redis password>
# JWT_SECRET=<fresh random secret of at least 32 bytes>
# ALLOWED_ORIGINS=http://localhost
# DOCKER_MONGO_URI=mongodb+srv://<url-encoded-user>:<url-encoded-password>@<your-cluster-host>.mongodb.net/edgegate?retryWrites=true&w=majority&appName=gatelab
# DOCKER_REDIS_URL=redis://:<url-encoded-password>@redis:6379/0
#
# MongoDB Atlas credentials are supplied only in DOCKER_MONGO_URI. The
# MONGO_ROOT_* variables above are optional and used only by local development.
# REDIS_PASSWORD must match the password in DOCKER_REDIS_URL.
# MONGO_URI and REDIS_URL above are for local development and are intentionally
# not used by Docker Compose.
