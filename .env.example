# Copy to .env for local development. For Docker production, create a separate
# .env.production file (ignored by Git) and set the variables shown below.
# Never commit real secrets or put them in this example.

# -------------------------------
# Local development defaults
# -------------------------------
NODE_ENV=development
ENTRY_LB_PORT=3010
GATEWAY_PORTS=3011,3012,3013
CONTROL_PLANE_PORT=5010
AUTH_PORT=5011
BACKEND_INSTANCES=4011:users,4014:users,4012:products,4015:products,4013:orders,4016:orders

MONGO_URI=mongodb://127.0.0.1:27018/edgegate
REDIS_URL=redis://localhost:6380
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=

# Frontend development server
VITE_PORT=5174
VITE_CONTROL_PLANE_PORT=5010
VITE_AUTH_PORT=5011
VITE_ENTRY_LB_PORT=3010
VITE_CONTROL_PLANE_URL=
VITE_AUTH_URL=
VITE_ENTRY_LB_URL=

# Browser origins allowed to call backend services.
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Auth (replace locally; this deliberately short placeholder fails production validation)
JWT_SECRET=replace-me-before-production
JWT_EXPIRES_IN=1h
DEMO_USER=admin
DEMO_PASSWORD=replace-with-a-local-only-demo-password

# Health checks (ms)
HEALTH_CHECK_INTERVAL=3000
PROXY_TIMEOUT=8000

# -------------------------------
# Docker production variables (Compose reads these from .env.production)
# -------------------------------
# Do not uncomment these examples verbatim or reuse local-development URLs.
# Create authenticated connection URLs with URL-encoded credentials as needed.
# Docker URLs must use service names, not localhost/127.0.0.1.
# Compose requires all of the variables below and has no insecure secret defaults.
#
# REDIS_PASSWORD=<fresh strong Redis password>
# JWT_SECRET=<fresh random secret of at least 32 bytes>
# ALLOWED_ORIGINS=http://localhost
# DOCKER_MONGO_URI=mongodb+srv://<url-encoded-user>:<url-encoded-password>@gatelab.bvnyegl.mongodb.net/edgegate?retryWrites=true&w=majority&appName=gatelab
# DOCKER_REDIS_URL=redis://:<url-encoded-password>@redis:6379/0
#
# MongoDB Atlas credentials are supplied only in DOCKER_MONGO_URI. The
# MONGO_ROOT_* variables above are optional and used only by local development.
# REDIS_PASSWORD must match the password in DOCKER_REDIS_URL.
# MONGO_URI and REDIS_URL above are for local development and are intentionally
# not used by Docker Compose.
