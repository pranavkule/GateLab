# Copy to .env. Default values below run this EdgeGate copy alongside
# another EdgeGate instance (which owns 3000-3003, 4001-4006, 5000, 5001,
# 5173, 27017, 6379). If you run this project standalone you may switch
# everything back to the classic ports.

# Ports
ENTRY_LB_PORT=3010
GATEWAY_PORTS=3011,3012,3013
CONTROL_PLANE_PORT=5010
AUTH_PORT=5011
# Backend service instances: port=serviceKey (users/products/orders)
BACKEND_INSTANCES=4011:users,4014:users,4012:products,4015:products,4013:orders,4016:orders

# Databases (host ports 27018/6380 -> container ports 27017/6379, see docker-compose.yml)
MONGO_URI=mongodb://127.0.0.1:27018/edgegate
REDIS_URL=redis://localhost:6380
# Optional local database authentication. Set the Mongo credentials together
# and use credential-bearing MONGO_URI/REDIS_URL values in the ignored .env.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=

# Frontend (read by Vite / the browser bundle)
VITE_PORT=5174
VITE_CONTROL_PLANE_PORT=5010
VITE_AUTH_PORT=5011
VITE_ENTRY_LB_PORT=3010

# Browser origins allowed to call backend services in development.
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Auth (replace locally; never use these placeholders as credentials)
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRES_IN=1h
DEMO_USER=admin
DEMO_PASSWORD=replace-with-a-local-only-demo-password

# Health checks (ms)
HEALTH_CHECK_INTERVAL=3000
PROXY_TIMEOUT=8000
