# EdgeGate instance #2 - ports do not collide with another EdgeGate copy
# (that one uses 3000-3003, 4001-4006, 5000, 5001, 5173, 27017, 6379)

# Ports
ENTRY_LB_PORT=3010
GATEWAY_PORTS=3011,3012,3013
CONTROL_PLANE_PORT=5010
AUTH_PORT=5011
# Backend service instances: port=serviceKey (users/products/orders)
BACKEND_INSTANCES=4011:users,4014:users,4012:products,4015:products,4013:orders,4016:orders

# Databases (host ports 27018/6380 -> container ports 27017/6379)
MONGO_URI=mongodb://127.0.0.1:27018/edgegate
REDIS_URL=redis://localhost:6380

# Auth
JWT_SECRET=edgegate2-dev-secret-change-in-production
JWT_EXPIRES_IN=1h
DEMO_USER=admin
DEMO_PASSWORD=admin123

# Health checks (ms)
HEALTH_CHECK_INTERVAL=3000
PROXY_TIMEOUT=8000
